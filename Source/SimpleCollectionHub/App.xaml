<base:ApplicationBase
	x:Class="SimpleCollectionHub.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:base="RW.Base.WPF"
	xmlns:hc="https://handyorg.github.io/handycontrol"
	xmlns:local="clr-namespace:SimpleCollectionHub">

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>

				<!-- 不跟系统走，启动时按设置套用浅色或深色 -->
				<hc:ThemeResources UsingSystemTheme="False"/>
				<hc:Theme/>

				<ResourceDictionary Source="pack://application:,,,/SimpleCollectionHub.Framework;component/Resources/FrameworkTheme.xaml"/>
				<ResourceDictionary Source="pack://application:,,,/SimpleCollectionHub.Framework;component/Resources/Themes/Light.xaml"/>

			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>

</base:ApplicationBase>
