<UserControl
	x:Class="SimpleCollectionHub.Views.CollectionDetailView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:base="RW.Base.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:f="SimpleCollectionHub.Framework"
	xmlns:local="clr-namespace:SimpleCollectionHub.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:res="SimpleCollectionHub.Resources"
	xmlns:s="clr-namespace:SimpleCollectionHub.Strings;assembly=SimpleCollectionHub.Strings"
	xmlns:vms="clr-namespace:SimpleCollectionHub.ViewModels"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=vms:CollectionDetailViewModel}"
	d:DesignHeight="800"
	d:DesignWidth="408"
	DataContext="{base:DISource Type=vms:CollectionDetailViewModel}"
	Style="{DynamicResource UserControlStyle}"
	mc:Ignorable="d">

	<dxmvvm:Interaction.Behaviors>
		<dxmvvm:OpenFileDialogService
			x:Name="OpenImageDialog"
			Filter="图片|*.png;*.jpg;*.jpeg;*.gif;*.bmp;*.webp|所有文件|*.*"
			Multiselect="True"
			Title="导入图片（将复制到本机库）"/>
	</dxmvvm:Interaction.Behaviors>

	<UserControl.Resources>
		<wpf:BindingProxy x:Key="ViewModel" Data="{Binding}"/>
		<wpf:CommandProxy x:Key="RemoveTagCommand" Command="{Binding RemoveTagCommand}"/>
		<wpf:CommandProxy x:Key="RemoveFieldCommand" Command="{Binding RemoveFieldCommand}"/>
		<wpf:CommandProxy x:Key="ImportImagesCommand" Command="{Binding ImportImagesCommand}"/>
		<wpf:CommandProxy x:Key="PasteImagesCommand" Command="{Binding PasteImagesCommand}"/>
		<wpf:CommandProxy x:Key="RemoveImageCommand" Command="{Binding RemoveImageCommand}"/>
		<wpf:CommandProxy x:Key="OpenLightboxCommand" Command="{Binding OpenLightboxCommand}"/>
		<wpf:CommandProxy x:Key="AddLinkCommand" Command="{Binding AddLinkCommand}"/>
		<wpf:CommandProxy x:Key="RemoveLinkCommand" Command="{Binding RemoveLinkCommand}"/>
		<wpf:CommandProxy x:Key="OpenLinkCommand" Command="{Binding OpenLinkCommand}"/>
	</UserControl.Resources>

	<Grid Background="#FFFFFF">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<DockPanel Grid.Row="0" Margin="16,14,12,8">
			<Button
				DockPanel.Dock="Right"
				Command="{Binding CloseDetailCommand}"
				Style="{StaticResource HubIconButton}"
				ToolTip="关闭">
				<wpf:FontIcon FontSize="12" Text="&#xE711;"/>
			</Button>
			<StackPanel>
				<TextBlock
					FontSize="18"
					FontWeight="SemiBold"
					Text="{Binding Workspace.DetailName, Mode=OneWay}"
					TextWrapping="Wrap"
					Visibility="{Binding Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityReConverter}}"/>
				<TextBox
					FontSize="16"
					Text="{Binding Workspace.DetailName, UpdateSourceTrigger=PropertyChanged}"
					Visibility="{Binding Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}}"/>
			</StackPanel>
		</DockPanel>

		<ScrollViewer Grid.Row="1" Padding="16,0,16,12" VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" Text="路径"/>
				<TextBox
					Margin="0,4,0,8"
					IsReadOnly="True"
					Text="{Binding Workspace.DetailPath, Mode=OneWay}"
					TextWrapping="Wrap"/>
				<WrapPanel Margin="0,0,0,12">
					<Border
						Margin="0,0,8,0"
						Padding="6,1"
						Background="#E8F8EC"
						CornerRadius="8"
						Visibility="{Binding Workspace.DetailExists, Converter={StaticResource Boolean2VisibilityConverter}}">
						<TextBlock FontSize="11" Foreground="#1E7A32" Text="路径可用"/>
					</Border>
					<Border
						Padding="6,1"
						Background="#FFF6D9"
						CornerRadius="8"
						Visibility="{Binding Workspace.DetailExists, Converter={StaticResource Boolean2VisibilityReConverter}}">
						<TextBlock FontSize="11" Foreground="#8A6A00" Text="路径丢失"/>
					</Border>
				</WrapPanel>
				<Button
					Margin="0,0,0,16"
					Command="{Binding OpenOriginalCommand}"
					Content="打开原目录"
					Style="{StaticResource HubButton}"/>

				<TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" Text="分组"/>
				<ComboBox
					Margin="0,4,0,16"
					DisplayMemberPath="Label"
					IsEnabled="{Binding Workspace.IsEditing, Mode=OneWay}"
					ItemsSource="{Binding Workspace.GroupPicks, Mode=OneWay}"
					SelectedValue="{Binding Workspace.DetailGroupId, UpdateSourceTrigger=PropertyChanged}"
					SelectedValuePath="GroupId"/>

				<TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8A8A8A" Text="标签"/>
				<ItemsControl Margin="0,6,0,8" ItemsSource="{Binding Workspace.DetailTags, Mode=OneWay}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,6,6" Padding="8,3" Background="#EEF3FF" CornerRadius="8">
								<StackPanel Orientation="Horizontal">
									<TextBlock FontSize="12" Foreground="#3557B8" Text="{Binding Mode=OneWay}"/>
									<Button
										Margin="6,0,0,0"
										Command="{StaticResource RemoveTagCommand}"
										CommandParameter="{Binding}"
										Content="×"
										FontSize="11"
										Style="{StaticResource HubButtonGhost}"
										Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<DockPanel
					Margin="0,0,0,16"
					Visibility="{Binding Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}}">
					<Button
						DockPanel.Dock="Right"
						Command="{Binding AddTagCommand}"
						Content="添加"
						Style="{StaticResource HubButton}"/>
					<TextBox
						Margin="0,0,8,0"
						Text="{Binding Workspace.NewTagText, UpdateSourceTrigger=PropertyChanged}"
						VerticalContentAlignment="Center"/>
				</DockPanel>

				<ItemsControl ItemsSource="{Binding Workspace.DetailFields, Mode=OneWay}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1">
								<StackPanel>
									<DockPanel Margin="0,0,0,8">
										<Button
											DockPanel.Dock="Right"
											Command="{StaticResource RemoveFieldCommand}"
											CommandParameter="{Binding}"
											Content="删除字段"
											FontSize="11"
											Style="{StaticResource HubButtonDanger}"
											Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}"/>
										<TextBlock
											FontWeight="SemiBold"
											Text="{Binding Label, Mode=OneWay}"
											Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityReConverter}, Source={StaticResource ViewModel}}"/>
										<TextBox
											Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
											Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}"/>
									</DockPanel>

									<StackPanel Visibility="{Binding IsText, Converter={StaticResource Boolean2VisibilityConverter}}">
										<TextBlock
											Text="{Binding TextValue, Mode=OneWay}"
											TextWrapping="Wrap"
											Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityReConverter}, Source={StaticResource ViewModel}}"/>
										<TextBox
											AcceptsReturn="True"
											Height="88"
											Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
											TextWrapping="Wrap"
											Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}"/>
									</StackPanel>

									<StackPanel Visibility="{Binding IsImages, Converter={StaticResource Boolean2VisibilityConverter}}">
										<ItemsControl ItemsSource="{Binding Images, Mode=OneWay}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<WrapPanel/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Grid Width="96" Height="72" Margin="0,0,8,8">
														<Button
															Padding="0"
															Command="{StaticResource OpenLightboxCommand}"
															CommandParameter="{Binding}">
															<Image Stretch="UniformToFill" Source="{Binding Preview, Mode=OneWay}"/>
														</Button>
														<Button
															HorizontalAlignment="Right"
															VerticalAlignment="Top"
															Command="{StaticResource RemoveImageCommand}"
															CommandParameter="{Binding}"
															Content="×"
															Style="{StaticResource HubButtonGhost}"
															Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}"/>
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<StackPanel
											Margin="0,4,0,0"
											Orientation="Horizontal"
											Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}">
											<Button
												Margin="0,0,8,0"
												Command="{StaticResource ImportImagesCommand}"
												CommandParameter="{Binding}"
												Content="导入图片"
												Style="{StaticResource HubButton}"/>
											<Button
												Command="{StaticResource PasteImagesCommand}"
												CommandParameter="{Binding}"
												Content="粘贴"
												Style="{StaticResource HubButton}"/>
										</StackPanel>
									</StackPanel>

									<StackPanel Visibility="{Binding IsLinks, Converter={StaticResource Boolean2VisibilityConverter}}">
										<ItemsControl ItemsSource="{Binding Links, Mode=OneWay}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<DockPanel Margin="0,0,0,6">
														<Button
															DockPanel.Dock="Right"
															Command="{StaticResource RemoveLinkCommand}"
															CommandParameter="{Binding}"
															Content="×"
															Style="{StaticResource HubButtonGhost}"
															Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}"/>
														<StackPanel>
															<Button
																HorizontalAlignment="Left"
																Command="{StaticResource OpenLinkCommand}"
																CommandParameter="{Binding Url}"
																Content="{Binding Title, Mode=OneWay}"
																Style="{StaticResource HubLinkButton}"/>
															<TextBox
																Margin="0,4,8,0"
																Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
																Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}"/>
															<TextBox
																Margin="0,4,8,0"
																Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
																Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}"/>
														</StackPanel>
													</DockPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<DockPanel
											Margin="0,8,0,0"
											Visibility="{Binding Data.Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ViewModel}}">
											<Button
												DockPanel.Dock="Right"
												Command="{StaticResource AddLinkCommand}"
												CommandParameter="{Binding}"
												Content="添加链接"
												Style="{StaticResource HubButton}"/>
											<StackPanel Margin="0,0,8,0">
												<TextBox
													Margin="0,0,0,4"
													Text="{Binding Data.Workspace.NewLinkTitle, UpdateSourceTrigger=PropertyChanged, Source={StaticResource ViewModel}}"/>
												<TextBox Text="{Binding Data.Workspace.NewLinkUrl, UpdateSourceTrigger=PropertyChanged, Source={StaticResource ViewModel}}"/>
											</StackPanel>
										</DockPanel>
									</StackPanel>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<WrapPanel Visibility="{Binding Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}}">
					<Button Margin="0,0,8,8" Command="{Binding AddImageFieldCommand}" Content="加图片字段" Style="{StaticResource HubButton}"/>
					<Button Margin="0,0,8,8" Command="{Binding AddTextFieldCommand}" Content="加文字字段" Style="{StaticResource HubButton}"/>
					<Button Margin="0,0,0,8" Command="{Binding AddLinkFieldCommand}" Content="加链接字段" Style="{StaticResource HubButton}"/>
				</WrapPanel>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="2" Padding="16,10" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0">
			<DockPanel>
				<Button
					DockPanel.Dock="Left"
					Command="{Binding RemoveFromLibraryCommand}"
					Content="从库中移除"
					Style="{StaticResource HubButtonDanger}"/>
				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
						Margin="0,0,8,0"
						Command="{Binding BeginEditCommand}"
						Content="编辑"
						Style="{StaticResource HubButton}"
						Visibility="{Binding Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityReConverter}}"/>
					<Button
						Margin="0,0,8,0"
						Command="{Binding CancelEditCommand}"
						Content="取消"
						Style="{StaticResource HubButton}"
						Visibility="{Binding Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}}"/>
					<Button
						Command="{Binding SaveCommand}"
						Content="保存"
						Style="{StaticResource HubButtonPrimary}"
						Visibility="{Binding Workspace.IsEditing, Converter={StaticResource Boolean2VisibilityConverter}}"/>
				</StackPanel>
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
