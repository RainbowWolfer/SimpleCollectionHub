<UserControl
	x:Class="SimpleCollectionHub.Views.CollectionLibraryView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:base="RW.Base.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="clr-namespace:SimpleCollectionHub.Views.Dialogs"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:f="SimpleCollectionHub.Framework"
	xmlns:local="clr-namespace:SimpleCollectionHub.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:res="SimpleCollectionHub.Resources"
	xmlns:s="clr-namespace:SimpleCollectionHub.Strings;assembly=SimpleCollectionHub.Strings"
	xmlns:vms="clr-namespace:SimpleCollectionHub.ViewModels"
	xmlns:wpf="RW.Common.WPF"
	d:DataContext="{d:DesignInstance Type=vms:CollectionLibraryViewModel}"
	d:DesignHeight="700"
	d:DesignWidth="800"
	DataContext="{base:DISource Type=vms:CollectionLibraryViewModel}"
	Style="{DynamicResource UserControlStyle}"
	mc:Ignorable="d">

	<dxmvvm:Interaction.Behaviors>
		<f:DialogService x:Name="AddGroupDialog" ContentType="{x:Type dialogs:AddGroupDialog}"/>
		<f:DialogService x:Name="AddItemDialog" ContentType="{x:Type dialogs:AddItemDialog}"/>
	</dxmvvm:Interaction.Behaviors>

	<UserControl.Resources>
		<wpf:CommandProxy x:Key="SelectItemCommand" Command="{Binding SelectItemCommand}"/>
		<wpf:CommandProxy x:Key="SelectCrumbCommand" Command="{Binding SelectCrumbCommand}"/>

		<DataTemplate x:Key="ItemCardTemplate">
			<Button
				Width="{Binding CoverWidth, Mode=OneWay}"
				Margin="0,0,14,14"
				Command="{StaticResource SelectItemCommand}"
				CommandParameter="{Binding}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource HubCardButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
								<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
				<StackPanel>
					<Grid Height="{Binding CoverHeight, Mode=OneWay}" Background="{DynamicResource HubCoverBrush}">
						<Image
							Stretch="UniformToFill"
							Source="{Binding Cover, Mode=OneWay}"
							Visibility="{Binding Cover, Converter={StaticResource Object2VisibilityConverter}}"/>
						<TextBlock
							Margin="10"
							VerticalAlignment="Bottom"
							FontWeight="Bold"
							Foreground="White"
							Text="{Binding PlaceholderTitle, Mode=OneWay}"
							TextWrapping="Wrap"
							Visibility="{Binding Cover, Converter={StaticResource Object2VisibilityReConverter}}"/>
					</Grid>
					<StackPanel Margin="10,8,10,10">
						<TextBlock
							FontWeight="SemiBold"
							Text="{Binding Name, Mode=OneWay}"
							TextTrimming="CharacterEllipsis"/>
						<TextBlock
							FontSize="11"
							Foreground="{DynamicResource ThirdlyTextBrush}"
							Text="{Binding Path, Mode=OneWay}"
							TextTrimming="CharacterEllipsis"/>
						<WrapPanel Margin="0,6,0,0">
							<Border
								Margin="0,0,6,0"
								Padding="6,1"
								Background="{DynamicResource HubOkBackground}"
								CornerRadius="8"
								Visibility="{Binding Exists, Converter={StaticResource Boolean2VisibilityConverter}}">
								<TextBlock FontSize="10" Foreground="{DynamicResource HubOkForeground}" Text="路径可用"/>
							</Border>
							<Border
								Margin="0,0,6,0"
								Padding="6,1"
								Background="{DynamicResource HubWarnBackground}"
								CornerRadius="8"
								Visibility="{Binding Exists, Converter={StaticResource Boolean2VisibilityReConverter}}">
								<TextBlock FontSize="10" Foreground="{DynamicResource HubWarnForeground}" Text="路径丢失"/>
							</Border>
							<ItemsControl ItemsSource="{Binding Tags, Mode=OneWay}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="0,0,6,0" Padding="6,1" Background="{DynamicResource HubChipBackground}" CornerRadius="8">
											<TextBlock FontSize="10" Foreground="{DynamicResource HubChipForeground}" Text="{Binding Mode=OneWay}"/>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</WrapPanel>
					</StackPanel>
				</StackPanel>
			</Button>
		</DataTemplate>

		<DataTemplate x:Key="ItemListTemplate">
			<Button
				Margin="0,0,0,6"
				Command="{StaticResource SelectItemCommand}"
				CommandParameter="{Binding}">
				<Button.Style>
					<Style TargetType="Button" BasedOn="{StaticResource HubListButton}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
								<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
								<Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="44"/>
						<ColumnDefinition Width="1.2*"/>
						<ColumnDefinition Width="1.6*"/>
						<ColumnDefinition Width="80"/>
					</Grid.ColumnDefinitions>
					<Border
						Width="44"
						Height="44"
						Background="{DynamicResource HubCoverBrush}"
						CornerRadius="6">
						<Image Stretch="UniformToFill" Source="{Binding Cover, Mode=OneWay}"/>
					</Border>
					<TextBlock
						Grid.Column="1"
						Margin="12,0,8,0"
						VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="{Binding Name, Mode=OneWay}"
						TextTrimming="CharacterEllipsis"/>
					<TextBlock
						Grid.Column="2"
						VerticalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource ThirdlyTextBrush}"
						Text="{Binding Path, Mode=OneWay}"
						TextTrimming="CharacterEllipsis"/>
					<TextBlock
						Grid.Column="3"
						VerticalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource ThirdlyTextBrush}"
						Text="{Binding GroupPath, Mode=OneWay}"
						TextTrimming="CharacterEllipsis"/>
				</Grid>
			</Button>
		</DataTemplate>
	</UserControl.Resources>

	<Grid Background="{DynamicResource BackgroundBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<DockPanel Grid.Row="0" LastChildFill="True" Margin="20,14,20,6">
			<WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
				<ComboBox
					Width="148"
					Height="32"
					Margin="0,0,8,4"
					DisplayMemberPath="Label"
					ItemsSource="{Binding IncompleteOptions, Mode=OneWay}"
					SelectedValue="{Binding Workspace.Incomplete, UpdateSourceTrigger=PropertyChanged}"
					SelectedValuePath="Value"
					VerticalContentAlignment="Center"/>
				<ComboBox
					Width="132"
					Height="32"
					Margin="0,0,8,4"
					DisplayMemberPath="Label"
					ItemsSource="{Binding SortOptions, Mode=OneWay}"
					SelectedValue="{Binding Workspace.SortBy, UpdateSourceTrigger=PropertyChanged}"
					SelectedValuePath="Value"
					VerticalContentAlignment="Center"/>
				<Border
					Margin="0,0,8,4"
					Background="{DynamicResource SecondaryRegionBrush}"
					CornerRadius="7"
					Padding="2">
					<StackPanel Orientation="Horizontal">
						<Button Command="{Binding SetCardsCommand}" Content="卡片">
							<Button.Style>
								<Style TargetType="Button" BasedOn="{StaticResource HubSegmentButton}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Workspace.IsCardsView, Mode=OneWay}" Value="True">
											<Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
											<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>
						<Button Command="{Binding SetListCommand}" Content="列表">
							<Button.Style>
								<Style TargetType="Button" BasedOn="{StaticResource HubSegmentButton}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding Workspace.IsListView, Mode=OneWay}" Value="True">
											<Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
											<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>
					</StackPanel>
				</Border>
				<Button
					Margin="0,0,8,4"
					Command="{Binding OpenAddGroupCommand}"
					Content="新建分组"
					Style="{StaticResource ButtonDefault}"/>
				<Button
					Margin="0,0,0,4"
					Command="{Binding OpenAddItemCommand}"
					Content="添加条目"
					Style="{StaticResource ButtonPrimary}"/>
			</WrapPanel>
			<StackPanel>
				<ItemsControl ItemsSource="{Binding Workspace.Crumbs, Mode=OneWay}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<Button
									Command="{StaticResource SelectCrumbCommand}"
									CommandParameter="{Binding}"
									Content="{Binding Name, Mode=OneWay}"
									IsEnabled="{Binding IsCurrent, Converter={StaticResource Boolean2BooleanReConverter}}"
									Style="{StaticResource HubLinkButton}"/>
								<TextBlock
									Margin="4,0"
									Foreground="{DynamicResource ThirdlyTextBrush}"
									Text="/"
									Visibility="{Binding IsCurrent, Converter={StaticResource Boolean2VisibilityReConverter}}"/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<StackPanel Orientation="Horizontal">
					<TextBlock
						FontSize="20"
						FontWeight="SemiBold"
						Text="{Binding Workspace.PageTitle, Mode=OneWay}"/>
					<TextBlock
						Margin="10,0,0,0"
						VerticalAlignment="Bottom"
						FontSize="12"
						Foreground="{DynamicResource ThirdlyTextBrush}"
						Text="{Binding Workspace.PageCountText, Mode=OneWay}"/>
				</StackPanel>
			</StackPanel>
		</DockPanel>

		<ScrollViewer Grid.Row="1" Padding="20,8,20,28" VerticalScrollBarVisibility="Auto">
			<Grid>
				<ItemsControl
					ItemsSource="{Binding Workspace.FlatItems, Mode=OneWay}"
					Visibility="{Binding Workspace.ShowFlat, Converter={StaticResource Boolean2VisibilityConverter}}">
					<ItemsControl.Style>
						<Style TargetType="ItemsControl">
							<Setter Property="ItemsPanel">
								<Setter.Value>
									<ItemsPanelTemplate>
										<WrapPanel/>
									</ItemsPanelTemplate>
								</Setter.Value>
							</Setter>
							<Setter Property="ItemTemplate" Value="{StaticResource ItemCardTemplate}"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding Workspace.IsListView, Mode=OneWay}" Value="True">
									<Setter Property="ItemsPanel">
										<Setter.Value>
											<ItemsPanelTemplate>
												<StackPanel/>
											</ItemsPanelTemplate>
										</Setter.Value>
									</Setter>
									<Setter Property="ItemTemplate" Value="{StaticResource ItemListTemplate}"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ItemsControl.Style>
				</ItemsControl>

				<ItemsControl
					ItemsSource="{Binding Workspace.Sections, Mode=OneWay}"
					Visibility="{Binding Workspace.ShowSections, Converter={StaticResource Boolean2VisibilityConverter}}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Margin="0,0,0,22">
								<DockPanel Margin="0,6,0,12">
									<TextBlock
										DockPanel.Dock="Left"
										FontSize="14"
										FontWeight="SemiBold"
										Text="{Binding Title, Mode=OneWay}"/>
									<Border
										Height="1"
										Margin="8,0,0,0"
										VerticalAlignment="Center"
										Background="{DynamicResource BorderBrush}"/>
								</DockPanel>
								<ItemsControl ItemTemplate="{StaticResource ItemCardTemplate}" ItemsSource="{Binding Items, Mode=OneWay}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
								</ItemsControl>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<StackPanel
					MaxWidth="420"
					Margin="0,48,0,0"
					HorizontalAlignment="Center"
					Visibility="{Binding Workspace.ShowEmpty, Converter={StaticResource Boolean2VisibilityConverter}}">
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="16"
						FontWeight="SemiBold"
						Text="{Binding Workspace.EmptyTitle, Mode=OneWay}"/>
					<Button
						Margin="0,16,0,0"
						HorizontalAlignment="Center"
						Command="{Binding OpenAddItemCommand}"
						Content="添加条目"
						Style="{StaticResource ButtonPrimary}"/>
				</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>
