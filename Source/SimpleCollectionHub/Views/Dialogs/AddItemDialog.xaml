<UserControl
	x:Class="SimpleCollectionHub.Views.Dialogs.AddItemDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:base="RW.Base.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:f="SimpleCollectionHub.Framework"
	xmlns:local="clr-namespace:SimpleCollectionHub.Views.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:res="SimpleCollectionHub.Resources"
	xmlns:s="clr-namespace:SimpleCollectionHub.Strings;assembly=SimpleCollectionHub.Strings"
	xmlns:wpf="RW.Common.WPF"
	d:Background="White"
	d:DataContext="{d:DesignInstance Type=local:AddItemDialogViewModel}"
	Style="{StaticResource DialogStyle.Base}"
	DataContext="{base:DISource Type=local:AddItemDialogViewModel}"
	mc:Ignorable="d">

	<StackPanel Width="420">
		<TextBlock
			Margin="0,0,0,12"
			Foreground="#5c5c5c"
			TextWrapping="Wrap"
			Text="选择一个已经存在的文件夹。软件只记下路径，不会在里面新建或修改任何文件。"/>

		<TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="已有路径"/>
		<DockPanel Margin="0,0,0,12" LastChildFill="True">
			<Button
				DockPanel.Dock="Right"
				Margin="8,0,0,0"
				Padding="10,4"
				Command="{Binding PickFolderCommand}"
				Content="浏览…"/>
			<TextBox
				IsReadOnly="True"
				Text="{Binding ItemPath, Mode=OneWay}"
				VerticalContentAlignment="Center"/>
		</DockPanel>
		<TextBlock
			Margin="0,0,0,12"
			FontSize="12"
			Foreground="#15803d"
			Text="路径可用"
			Visibility="{Binding PathExists, Converter={StaticResource Boolean2VisibilityConverter}}"/>

		<TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="显示名"/>
		<TextBox
			Margin="0,0,0,12"
			Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
			VerticalContentAlignment="Center"/>

		<TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="放到分组"/>
		<ComboBox
			DisplayMemberPath="Label"
			ItemsSource="{Binding Groups, Mode=OneWay}"
			SelectedItem="{Binding SelectedGroup, UpdateSourceTrigger=PropertyChanged}"/>
	</StackPanel>
</UserControl>
