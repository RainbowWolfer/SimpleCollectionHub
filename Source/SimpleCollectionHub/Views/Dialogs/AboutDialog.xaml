<UserControl
	x:Class="SimpleCollectionHub.Views.Dialogs.AboutDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:base="RW.Base.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:f="SimpleCollectionHub.Framework"
	xmlns:local="clr-namespace:SimpleCollectionHub.Views.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:res="SimpleCollectionHub.Resources"
	xmlns:s="clr-namespace:SimpleCollectionHub.Strings;assembly=SimpleCollectionHub.Strings"
	xmlns:wpf="RW.Common.WPF"
	d:Background="White"
	d:DataContext="{d:DesignInstance Type=local:AboutDialogViewModel}"
	Style="{StaticResource DialogStyle.Base}"
	DataContext="{base:DISource Type=local:AboutDialogViewModel}"
	mc:Ignorable="d">

	<StackPanel Width="460">
		<TextBlock
			FontSize="16"
			FontWeight="SemiBold"
			Text="SimpleCollectionHub"/>
		<TextBlock
			Margin="0,8,0,0"
			Foreground="{DynamicResource SecondaryTextBrush}"
			TextWrapping="Wrap"
			Text="给已经躺在磁盘上的游戏、音乐、视频目录贴一层封面、截图、文字和链接。原文件继续留在原地。"/>
		<TextBlock
			Margin="0,14,0,6"
			FontWeight="SemiBold"
			Text="本机库规则"/>
		<TextBlock Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="22" TextWrapping="Wrap">
			<Run Text="• 元数据只存在 %LocalAppData%\RainbowWolfer\SimpleCollectionHub\（SQLite + Media）。"/>
			<LineBreak/>
			<Run Text="• 不会在绑定路径新建、修改或删除任何文件，包括 sidecar。"/>
			<LineBreak/>
			<Run Text="• 「从库中移除」只删库记录；「打开原目录」只打开资源管理器。"/>
			<LineBreak/>
			<Run Text="• 标签只用于筛选（多选为或），不进入分组树，也不改树的计数。"/>
			<LineBreak/>
			<Run Text="• 导入的图片会复制进 Media 文件夹，库里只记相对路径。"/>
		</TextBlock>
	</StackPanel>
</UserControl>
