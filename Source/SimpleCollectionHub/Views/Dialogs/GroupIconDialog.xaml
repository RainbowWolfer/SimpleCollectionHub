<UserControl
	x:Class="SimpleCollectionHub.Views.Dialogs.GroupIconDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:base="RW.Base.WPF"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:f="SimpleCollectionHub.Framework"
	xmlns:local="clr-namespace:SimpleCollectionHub.Views.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:res="SimpleCollectionHub.Resources"
	xmlns:s="clr-namespace:SimpleCollectionHub.Strings;assembly=SimpleCollectionHub.Strings"
	xmlns:wpf="RW.Common.WPF"
	d:Background="White"
	d:DataContext="{d:DesignInstance Type=local:GroupIconDialogViewModel}"
	Style="{StaticResource DialogStyle.Base}"
	DataContext="{base:DISource Type=local:GroupIconDialogViewModel}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<wpf:CommandProxy x:Key="SelectIconCommand" Command="{Binding SelectIconCommand}"/>
		<wpf:CommandProxy x:Key="SelectColorCommand" Command="{Binding SelectColorCommand}"/>
	</UserControl.Resources>

	<Grid Width="520">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="220"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal">
			<Border
				Width="40"
				Height="40"
				Background="#f3f3f3"
				CornerRadius="8">
				<wpf:FontIcon
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="20"
					Foreground="{Binding PreviewBrush, Mode=OneWay}"
					Text="{Binding PreviewGlyph, Mode=OneWay}"/>
			</Border>
			<StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
				<TextBlock FontWeight="SemiBold" Text="{Binding TargetName, Mode=OneWay}"/>
			</StackPanel>
		</StackPanel>

		<TextBox
			Grid.Row="1"
			Margin="0,12,0,8"
			Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding Icons, Mode=OneWay}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button
							Width="44"
							Height="44"
							Margin="3"
							Padding="0"
							Command="{StaticResource SelectIconCommand}"
							CommandParameter="{Binding}"
							ToolTip="{Binding Name, Mode=OneWay}">
							<Button.Style>
								<Style TargetType="Button" BasedOn="{StaticResource HubIconPickButton}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
											<Setter Property="BorderBrush" Value="#326CF3"/>
											<Setter Property="Background" Value="#E8EFFE"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<wpf:FontIcon FontSize="18" Text="{Binding Glyph, Mode=OneWay}"/>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<StackPanel Grid.Row="3" Margin="0,12,0,0">
			<TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="颜色"/>
			<ItemsControl ItemsSource="{Binding Colors, Mode=OneWay}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button
							Width="22"
							Height="22"
							Margin="3"
							Padding="0"
							Background="{Binding Brush, Mode=OneWay}"
							Command="{StaticResource SelectColorCommand}"
							CommandParameter="{Binding}">
							<Button.Style>
								<Style TargetType="Button" BasedOn="{StaticResource HubColorSwatch}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
											<Setter Property="BorderBrush" Value="#1B1B1B"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<DockPanel Margin="0,8,0,0">
				<Button
					DockPanel.Dock="Right"
					Margin="8,0,0,0"
					Padding="10,4"
					Command="{Binding ApplyCustomColorCommand}"
					Content="应用"/>
				<TextBox
					Text="{Binding CustomColor, UpdateSourceTrigger=PropertyChanged}"
					VerticalContentAlignment="Center"/>
			</DockPanel>
		</StackPanel>
	</Grid>
</UserControl>
