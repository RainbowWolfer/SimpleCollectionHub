<#@ template language="C#" debug="false" hostspecific="true" #>
<#@ output extension=".cs" encoding="utf-8" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>

namespace SimpleCollectionHub.Resources.Images;

public static class ImageResources
{
    public const string AssemblyName = "SimpleCollectionHub.Resources";

<#
string imageDirectory = Path.GetDirectoryName(Host.TemplateFile);
string[] extensions = { ".png", ".jpg", ".gif", ".ico" };
    
var imageFiles = Directory.GetFiles(imageDirectory)
    .Where(f => extensions.Contains(Path.GetExtension(f).ToLower()))
    .ToArray();

foreach (string file in imageFiles)
{
    string fileName = Path.GetFileName(file);
    string extension = Path.GetExtension(file).Substring(1).ToUpper();
    string propertyName = Path.GetFileNameWithoutExtension(file).Replace("-", "_").Replace(" ", "_") + "_" + extension;
#>
    /// <summary> 对应资源文件: <#= fileName #> </summary>
    public static string <#= propertyName #> { get; } = $"pack://application:,,,/{AssemblyName};component/Images/<#= fileName #>";

<#
}
#>
}
