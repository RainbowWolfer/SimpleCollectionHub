<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:base="RW.Base.WPF"
	xmlns:c="clr-namespace:SimpleCollectionHub.Framework.Controls"
	xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
	xmlns:res="SimpleCollectionHub.Resources"
	xmlns:s="clr-namespace:SimpleCollectionHub.Strings;assembly=SimpleCollectionHub.Strings"
	xmlns:vm="clr-namespace:SimpleCollectionHub.Framework.ViewModels"
	xmlns:vms="clr-namespace:SimpleCollectionHub.Framework.ViewModelServices"
	xmlns:wpf="RW.Common.WPF">

	<ResourceDictionary.MergedDictionaries>

		<ResourceDictionary Source="pack://application:,,,/RW.Common.WPF;component/Resources/Generic.xaml"/>

		<ResourceDictionary Source="/SimpleCollectionHub.Resources;component/ResourcesGeneric.xaml"/>

		<ResourceDictionary Source="/SimpleCollectionHub.Framework;component/Resources/Converters.xaml"/>
		<ResourceDictionary Source="/SimpleCollectionHub.Framework;component/Resources/Data.xaml"/>

	</ResourceDictionary.MergedDictionaries>


	<Style x:Key="Control.Base" TargetType="Control">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
	</Style>

	<Style x:Key="ContentControl.Base" TargetType="ContentControl">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
	</Style>

	<Style TargetType="ContentControl" BasedOn="{StaticResource ContentControl.Base}"/>

	<Style x:Key="ItemsControl.Base" TargetType="ItemsControl">
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
	</Style>

	<Style TargetType="ItemsControl" BasedOn="{StaticResource ItemsControl.Base}"/>


	<Style TargetType="ToolTip">
		<!--<Setter Property="FontSize" Value="28"/>-->
		<Setter Property="FontFamily" Value="{Binding Source={x:Static res:ResourceKeys.DefaultFont}}"/>
	</Style>

	<Style x:Key="Separator.Horizontal" TargetType="Border">
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="LightGray"/>
		<Setter Property="CornerRadius" Value="1"/>
		<Setter Property="Width" Value="2"/>
		<Setter Property="Height" Value="12"/>
		<Setter Property="Margin" Value="4,0"/>
	</Style>


	<Style x:Key="Separator.Vertical" TargetType="Border">
		<Setter Property="VerticalAlignment" Value="Stretch"/>
		<Setter Property="Background" Value="LightGray"/>
		<Setter Property="CornerRadius" Value="1"/>
		<!--<Setter Property="Width" Value="12"/>-->
		<Setter Property="Height" Value="2"/>
		<Setter Property="Margin" Value="0,4"/>
	</Style>


	<!-- 字体图标默认样式，套用 Segoe Fluent Icons，使 <wpf:FontIcon Text="&#xE721;"/> 开箱即用 -->
	<Style x:Key="FontIconBase" TargetType="wpf:FontIcon" BasedOn="{StaticResource IconText.Default}">
		<Setter Property="TextAlignment" Value="Center"/>
	</Style>

	<Style TargetType="wpf:FontIcon" BasedOn="{StaticResource FontIconBase}"/>



	<Style x:Key="WindowBaseStyle" TargetType="c:WindowBase">
		<Setter Property="Icon" Value="{DynamicResource AppIcon_PNG}"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="UseLayoutRounding" Value="True"/>
		<!--<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>-->
	</Style>

	<Style TargetType="c:WindowBase" BasedOn="{StaticResource WindowBaseStyle}"/>

	<Style x:Key="DialogWindowWrapper" TargetType="c:DialogWindowWrapper">
		<Setter Property="Padding" Value="0"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="c:DialogWindowWrapper">
					<Border
						Padding="{TemplateBinding Padding}"
						BorderThickness="{TemplateBinding BorderThickness}"
						BorderBrush="{TemplateBinding BorderBrush}"
						Background="{TemplateBinding Background}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="*"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<wpf:ClippingBorder Grid.Row="0" Padding="{TemplateBinding Padding}">
								<ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
							</wpf:ClippingBorder>

							<Border Grid.Row="1">
								<ItemsControl
									Margin="4"
									HorizontalAlignment="Right"
									Focusable="False"
									IsTabStop="False"
									ItemsSource="{TemplateBinding DialogCommands}">

									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>

									<ItemsControl.ItemTemplateSelector>
										<c:DialogWindowWrapperButtonTemplateSelector>

											<c:DialogWindowWrapperButtonTemplateSelector.Default>
												<DataTemplate DataType="{x:Type vm:DialogCommand}">
													<!-- Style="{StaticResource ButtonDefault}" -->
													<Button
														MinWidth="80"
														Margin="4"
														Command="{Binding RelativeSource={RelativeSource AncestorType=c:DialogWindowWrapper}, Path=DialogButtonCommand}"
														CommandParameter="{Binding}"
														Content="{Binding Content}"
														IsEnabled="{Binding IsEnabled}"/>
												</DataTemplate>
											</c:DialogWindowWrapperButtonTemplateSelector.Default>

											<c:DialogWindowWrapperButtonTemplateSelector.Primary>
												<DataTemplate DataType="{x:Type vm:DialogCommand}">
													<!-- Style="{StaticResource ButtonPrimary}" -->
													<Button
														MinWidth="80"
														Margin="4"
														Command="{Binding RelativeSource={RelativeSource AncestorType=c:DialogWindowWrapper}, Path=DialogButtonCommand}"
														CommandParameter="{Binding}"
														Content="{Binding Content}"
														IsEnabled="{Binding IsEnabled}"/>
												</DataTemplate>
											</c:DialogWindowWrapperButtonTemplateSelector.Primary>

										</c:DialogWindowWrapperButtonTemplateSelector>
									</ItemsControl.ItemTemplateSelector>

								</ItemsControl>
							</Border>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="c:DialogWindowWrapper" BasedOn="{StaticResource DialogWindowWrapper}"/>

	<Style x:Key="DialogStyle.Base" TargetType="UserControl">
		<Setter Property="Padding" Value="14"/>

		<Setter Property="dxmvvm:Interaction.BehaviorsTemplate">
			<Setter.Value>
				<DataTemplate DataType="{x:Type vm:IDialogViewModel}">
					<ItemsControl>
						<dxmvvm:EventToCommand Command="{Binding LoadedCommand}" EventName="Loaded" PassEventArgsToCommand="True"/>
						<!--<vms:CurrentDialogServiceEx ClosingCommand="{Binding ClosingCommand}"/>-->
						<base:DispatcherServiceEx/>
						<vms:MessageBoxServiceEx/>
						<base:TypedUIObjectService Name="DialogUserControlService"/>
					</ItemsControl>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="UserControlStyle" TargetType="UserControl">
		<Setter Property="dxmvvm:Interaction.BehaviorsTemplate">
			<Setter.Value>
				<DataTemplate DataType="{x:Type vm:ViewModelBaseEx}">
					<ItemsControl>
						<base:LoadedService Command="{Binding LoadedCommand}" OnlyOnce="False"/>
						<base:LoadedService Command="{Binding LoadedOnceCommand}" OnlyOnce="True"/>
						<base:DispatcherServiceEx/>
						<vms:MessageBoxServiceEx/>
						<base:TypedUIObjectService Name="UserControlService"/>
					</ItemsControl>
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>



</ResourceDictionary>