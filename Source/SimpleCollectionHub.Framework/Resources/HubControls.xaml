<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:hc="https://handyorg.github.io/handycontrol">

	<!--
		按钮、输入框、树、菜单、滚动条用 HandyControl 的默认样式。
		下面只保留库里没有、或必须改模板的样式。改模板的都从 HandyControl 原样式复制后再改。
	-->

	<!-- 从 ButtonCustom 来：透明底，悬停用主题的次级区域色。图标按钮和文字按钮都基于它。 -->
	<Style x:Key="HubGhostButton" TargetType="Button" BasedOn="{StaticResource ButtonCustom}">
		<Setter Property="Height" Value="NaN"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="MinHeight" Value="0"/>
		<Setter Property="Padding" Value="8,6"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Setter Property="hc:BorderElement.CornerRadius" Value="4"/>
		<Setter Property="hc:BackgroundSwitchElement.MouseHoverBackground" Value="{DynamicResource SecondaryRegionBrush}"/>
		<Setter Property="hc:BackgroundSwitchElement.MouseDownBackground" Value="{DynamicResource BorderBrush}"/>
	</Style>

	<Style x:Key="HubIconButton" TargetType="Button" BasedOn="{StaticResource HubGhostButton}">
		<Setter Property="Width" Value="28"/>
		<Setter Property="Height" Value="28"/>
		<Setter Property="MinWidth" Value="28"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
	</Style>

	<Style x:Key="HubTreeButton" TargetType="Button" BasedOn="{StaticResource HubIconButton}">
		<Setter Property="Width" Value="22"/>
		<Setter Property="Height" Value="22"/>
		<Setter Property="MinWidth" Value="22"/>
	</Style>

	<Style x:Key="HubLinkButton" TargetType="Button" BasedOn="{StaticResource ButtonCustom}">
		<Setter Property="Height" Value="NaN"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
		<Setter Property="hc:BackgroundSwitchElement.MouseHoverBackground" Value="Transparent"/>
		<Setter Property="hc:BackgroundSwitchElement.MouseDownBackground" Value="Transparent"/>
	</Style>

	<!--
		从 HandyControl ButtonBaseStyle 复制。
		原模板用横向 StackPanel 包内容和图标，卡片需要内容撑满并按圆角裁切，所以换掉模板。
	-->
	<Style x:Key="HubCardButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseBaseStyle}">
		<Setter Property="Height" Value="NaN"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="MinHeight" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="VerticalContentAlignment" Value="Stretch"/>
		<Setter Property="hc:BorderElement.CornerRadius" Value="8"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<hc:SimplePanel>
						<Border Background="{TemplateBinding Background}" CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"/>
						<Border
							BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
							ClipToBounds="True">
							<ContentPresenter
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
						</Border>
					</hc:SimplePanel>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Opacity" Value="0.92"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- 同样从 ButtonBaseStyle 复制。列表行要横向撑满，原模板的 StackPanel 做不到。 -->
	<Style x:Key="HubListButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseBaseStyle}">
		<Setter Property="Height" Value="NaN"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="Padding" Value="8,6"/>
		<Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="hc:BorderElement.CornerRadius" Value="6"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<hc:SimplePanel>
						<Border Background="{TemplateBinding Background}" CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"/>
						<Border
							BorderThickness="{TemplateBinding BorderThickness}"
							BorderBrush="{TemplateBinding BorderBrush}"
							CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
							<ContentPresenter
								Margin="{TemplateBinding Padding}"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
						</Border>
					</hc:SimplePanel>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
			</Trigger>
		</Style.Triggers>
	</Style>

	<!-- 从 ButtonGroupItemBaseStyle 复制，去掉图标槽，给卡片/列表切换用。 -->
	<Style x:Key="HubSegmentButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseBaseStyle}">
		<Setter Property="Height" Value="26"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="Padding" Value="10,0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
		<Setter Property="hc:BorderElement.CornerRadius" Value="4"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="BorderRoot"
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
						<ContentPresenter
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							RecognizesAccessKey="True"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- 筛选标签。外形沿用 ButtonBaseStyle，只把圆角收成胶囊，选中色由界面上的触发器改。 -->
	<Style x:Key="HubTagChip" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
		<Setter Property="Height" Value="26"/>
		<Setter Property="MinWidth" Value="0"/>
		<Setter Property="Padding" Value="10,0"/>
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
		<Setter Property="hc:BorderElement.CornerRadius" Value="13"/>
	</Style>

	<!-- 图标格子。ButtonDefault 的模板已经够用，只改尺寸和圆角。 -->
	<Style x:Key="HubIconPickButton" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
		<Setter Property="Width" Value="44"/>
		<Setter Property="Height" Value="44"/>
		<Setter Property="MinWidth" Value="44"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="hc:BorderElement.CornerRadius" Value="8"/>
	</Style>

	<!-- 色块。基于 ButtonBaseStyle，不用 ButtonDefault：后者悬停会把背景改成主题色，色块就看不出原来的颜色了。 -->
	<Style x:Key="HubColorSwatch" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
		<Setter Property="Width" Value="22"/>
		<Setter Property="Height" Value="22"/>
		<Setter Property="MinWidth" Value="22"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="hc:BorderElement.CornerRadius" Value="4"/>
	</Style>

</ResourceDictionary>
