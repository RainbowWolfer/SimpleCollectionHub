<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- 状态色块。HandyControl 的 Success/Warning 是实心色，铺在小标签上太重，所以浅色单独给一层淡底。 -->
	<Color x:Key="HubOkBackgroundColor">#E8F8EC</Color>
	<Color x:Key="HubOkForegroundColor">#1E7A32</Color>
	<Color x:Key="HubWarnBackgroundColor">#FFF6D9</Color>
	<Color x:Key="HubWarnForegroundColor">#8A6A00</Color>
	<Color x:Key="HubChipBackgroundColor">#EEF3FF</Color>
	<Color x:Key="HubChipForegroundColor">#3557B8</Color>
	<Color x:Key="HubCoverColor">#D7DEEA</Color>

	<SolidColorBrush x:Key="HubOkBackground" Color="{DynamicResource HubOkBackgroundColor}"/>
	<SolidColorBrush x:Key="HubOkForeground" Color="{DynamicResource HubOkForegroundColor}"/>
	<SolidColorBrush x:Key="HubWarnBackground" Color="{DynamicResource HubWarnBackgroundColor}"/>
	<SolidColorBrush x:Key="HubWarnForeground" Color="{DynamicResource HubWarnForegroundColor}"/>
	<SolidColorBrush x:Key="HubChipBackground" Color="{DynamicResource HubChipBackgroundColor}"/>
	<SolidColorBrush x:Key="HubChipForeground" Color="{DynamicResource HubChipForegroundColor}"/>
	<SolidColorBrush x:Key="HubCoverBrush" Color="{DynamicResource HubCoverColor}"/>

</ResourceDictionary>
